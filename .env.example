# Copy this file to .env and fill in at least a Gemini key.
# Get a Gemini key: https://aistudio.google.com/app/apikey

GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Optional: used when LLM_PROVIDER=openai (Step 3 LiteLLM)
OPENAI_API_KEY=

# Optional: used when LLM_PROVIDER=anthropic (Step 3 LiteLLM)
ANTHROPIC_API_KEY=

# gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
LITELLM_MODEL=openai/gpt-4o-mini
